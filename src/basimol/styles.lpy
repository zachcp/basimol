(def ^:private surface-defaults
  {:quality 3
   :scale-radii 1.5
   :probe-size 1.0
   :relaxation-steps 10
   :separate "chain_id"
   :group-id 0
   :color-source "Alpha Carbon"
   :blur 2
   :shade-smooth true})

(defn surface [& {:as opts}]
  (let [{:keys [quality
                scale-radii
                probe-size
                relaxation-steps
                separate
                group-id
                color-source
                blur
                shade-smooth]}
        (merge surface-defaults opts)]
    (styles/StyleSurface :quality quality
                         :scale_radii scale-radii
                         :probe_size probe-size
                         :relaxation_steps relaxation-steps
                         :separate separate
                         :group_id group-id
                         :color_source color-source
                         :blur blur
                         :shade_smooth shade-smooth)))
