(ns basimol.styles
  (:require  [molecularnodes.nodes.styles :as styles]))

(defn- kebab->snake [k]
  (-> k name (clojure.string/replace "-" "_") keyword))

(defn- apply-style [style-fn defaults opts]
  (let [merged-opts (merge defaults opts)
        snake-case-opts (mapcat (fn [[k v]] [(kebab->snake k) v]) merged-opts)]
    (apply style-fn snake-case-opts)))

(def ^:private ribbon-defaults
  {:quality 3
   :color-blur false
   :shade-smooth false
   :backbone-smoothing 0.5
   :backbone-threshold 4.5
   :base-scale [2.5 0.5 7.0]
   :backbone-radius 2.0
   :backbone-shape "Cylinder"
   :base-resolution 4
   :base-realize false
   :uv-map false
   :u-component nil})

(defn ribbon  [& {:as opts}]
  (let [{:keys [quality
                color-blur
                shade-smooth
                backbone-smoothing
                backbone-threshold
                base-scale
                backbone-radius
                backbone-shape
                base-resolution
                base-realize
                uv-map
                u-component]}
        (merge ribbon-defaults opts)]
    (styles/StyleRibbon :quality quality
                        :color_blur color-blur
                        :shade_smooth shade-smooth
                        :backbone_smoothing backbone-smoothing
                        :backbone_threshold backbone-threshold
                        :base_scale base-scale
                        :backbone_radius backbone-radius
                        :backbone_shape backbone-shape
                        :base_resolution base-resolution
                        :base_realize base-realize
                        :uv_map uv-map
                        :u_component u-component)))

(defn ribbon-short [& {:as opts}]
  (apply-style styles/StyleRibbon ribbon-defaults opts))

(def ^:private cartoon-defaults
  {:quality 2
   :dssp false
   :cylinders false
   :arrows true
   :rounded false
   :thickness 0.6
   :width 2.2
   :loop-radius 0.3
   :smoothing 0.5
   :backbone-shape "Cylinder"
   :backbone-radius 2.0
   :base-shape "Rectangle"
   :base-realize false
   :color-blur true
   :shade-smooth true})

(defn cartoon [& {:as opts}]
  (let [{:keys [quality
                dssp
                cylinders
                arrows
                rounded
                thickness
                width
                loop-radius
                smoothing
                backbone-shape
                backbone-radius
                base-shape
                base-realize
                color-blur
                shade-smooth]}
        (merge cartoon-defaults opts)]
    (styles/StyleCartoon :quality quality
                         :dssp dssp
                         :cylinders cylinders
                         :arrows arrows
                         :rounded rounded
                         :thickness thickness
                         :width width
                         :loop_radius loop-radius
                         :smoothing smoothing
                         :backbone_shape backbone-shape
                         :backbone_radius backbone-radius
                         :base_shape base-shape
                         :base_realize base-realize
                         :color_blur color-blur
                         :shade_smooth shade-smooth)))

(def ^:private ball-and-stick-defaults
  {:quality 2
   :geometry "Instance"
   :sphere-radii 0.3
   :bond-split false
   :bond-find false
   :bond-radius 0.3
   :color-blur false
   :shade-smooth true})

(defn ball-and-stick [& {:as opts}]
  (let [{:keys [quality
                geometry
                sphere-radii
                bond-split
                bond-find
                bond-radius
                color-blur
                shade-smooth]}
        (merge ball-and-stick-defaults opts)]
    (styles/StyleBallandStick :quality quality
                              :geometry geometry
                              :sphere_radii sphere-radii
                              :bond_split bond-split
                              :bond_find bond-find
                              :bond_radius bond-radius
                              :color_blur color-blur
                              :shade_smooth shade-smooth)))

(def ^:private spheres-defaults
  {:geometry "Point"
   :radii 0.8
   :sphere-subdivisions 2
   :shade-smooth true})

(defn spheres [& {:as opts}]
  (let [{:keys [geometry
                radii
                sphere-subdivisions
                shade-smooth]}
        (merge spheres-defaults opts)]
    (styles/Spheres :geometry geometry
                    :radii radii
                    :sphere_subdivisions sphere-subdivisions
                    :shade_smooth shade-smooth)))

(def ^:private sticks-defaults
  {:quality 3
   :radius 0.2
   :color-blur false
   :shade-smooth true})

(defn sticks [& {:as opts}]
