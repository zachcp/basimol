(ns basimol.styles
  (:require  [molecularnodes.nodes.styles :as styles]))

(def ^:private ribbon-defaults
  {:quality 3
   :color-blur false
   :shade-smooth false
   :backbone-smoothing 0.5
   :backbone-threshold 4.5
   :base-scale [2.5 0.5 7.0]
   :backbone-radius 2.0
   :backbone-shape "Cylinder"
   :base-resolution 4
   :base-realize false
   :uv-map false
   :u-component nil})

(defn ribbon  [& {:as opts}]
  (let [{:keys [quality
                color-blur
                shade-smooth
                backbone-smoothing
                backbone-threshold
                base-scale
                backbone-radius
                backbone-shape
                base-resolution
                base-realize
                uv-map
                u-component]}
        (merge ribbon-defaults opts)]
    (styles/StyleRibbon :quality quality
                        :color_blur color-blur
                        :shade_smooth shade-smooth
                        :backbone_smoothing backbone-smoothing
                        :backbone_threshold backbone-threshold
                        :base_scale base-scale
                        :backbone_radius backbone-radius
                        :backbone_shape backbone-shape
                        :base_resolution base-resolution
                        :base_realize base-realize
                        :uv_map uv-map
                        :u_component u-component)))

